# Copy to .env.local. Use the project URL and publishable key from Supabase Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact trusted application origin; required for signup confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never put a service_role/secret key in NEXT_PUBLIC variables or browser code.
# Optional, only for the destructive isolated database test harness:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/cricket_fantasy_test
